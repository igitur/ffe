structure data {
    type separated ,

    record entry {
        field code * status_lookup
        field value
    }
}

lookup status_lookup {
    search exact
    pair A "Active"
    pair B "Blocked"
    pair C "Closed"
    pair P "Pending"
    default-value "Unknown"
}

output test_upper {
    data "%n: %t\n"
    lookup "%n: %t -> %L\n"
    indent " "
}

output test_lower {
    data "%n: %t\n"
    lookup "%n: %t -> %l\n"
    indent " "
}