structure data {
    type separated ,

    record person {
        field first_name
        field last_name
        field age
        field id
    }
}

anonymize test1 {
    method first_name MASK
    method last_name MASK 2
    method age MASK -2 1
    method id MASK 1 3
}

output raw {
    data "%d"
}

output default {
    data "%n: %t\n"
    indent " "
}