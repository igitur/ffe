structure test_structure {
    type fixed
    record test_record {
        field FirstName 10
        field LastName 15
        field Age 3
        field Score 5
    }
}

output directives {
    # Print all directives for each field
    data "s=%s r=%r o=%o O=%O i=%i I=%I n=%n t=%t d=%d D=%D C=%C p=%p\n"
}